# ====================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN WEB APP QUẢN LÝ KPI GIÁO VIÊN (SELF-HOSTED)
# ====================================================================

# 1. Cấu hình Supabase (PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. Cấu hình Google Drive Service Account (Tự động lưu minh chứng)
# Tạo tại: https://console.cloud.google.com/ -> IAM & Admin -> Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=kpi-drive-uploader@your-project-id.iam.gserviceaccount.com
# Lưu ý: Private Key có thể chứa \n giữa các dòng
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Hoặc dán toàn bộ nội dung file JSON Service Account vào đây:
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON='{"type":"service_account","project_id":...}'

# 3. ID Thư mục Google Drive Gốc (Chia sẻ quyền 'Editor' cho email Service Account)
# URL: https://drive.google.com/drive/folders/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OIvE2up0I -> ID là chuỗi sau /folders/
GOOGLE_DRIVE_ROOT_FOLDER_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OIvE2up0I

# 4. Tùy chọn thông tin trường học mặc định
NEXT_PUBLIC_SCHOOL_NAME="Trường THPT Chuyên Nguyễn Trãi"
NEXT_PUBLIC_ACADEMIC_YEAR="2024-2025"
